# Copy to .env.local and fill in what you need. Every variable is optional.

# --- Site identity (shown in the privacy policy, accessibility statement and footer) ---
NEXT_PUBLIC_SITE_NAME=Sudoku
NEXT_PUBLIC_OPERATOR_NAME=           # who is responsible for the site (a person or company)
NEXT_PUBLIC_CONTACT_EMAIL=           # published in the policies for privacy and accessibility requests
NEXT_PUBLIC_SITE_URL=

# --- Ads (Google AdSense) ---
# Leave these empty and no ad code is loaded, no consent banner appears and no ad space is rendered.
# With them set, visitors are asked first. Ad code loads only after "Allow ads" or
# "Non-personalised ads only". An ad slot only becomes visible once AdSense actually fills it;
# if it is unfilled, blocked, or the script fails to load, the slot is removed.
NEXT_PUBLIC_ADSENSE_CLIENT=          # e.g. ca-pub-1234567890123456
NEXT_PUBLIC_ADSENSE_SLOT=            # default ad unit id, used by every placement
NEXT_PUBLIC_ADSENSE_SLOT_PLAY=       # optional: ad unit for the Play tab
NEXT_PUBLIC_ADSENSE_SLOT_BOOK=       # optional: ad unit for the Make a book tab
